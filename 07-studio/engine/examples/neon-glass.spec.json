      "visual": { "type": "scene3d", "camera": "push", "objects": [{ "kind": "chip", "icon": "brain", "label": "Modelo IA", "highlight": true }] }
    },
    {
      "id": "dato",
      "narration": "En muchos equipos, más del cincuenta por ciento de las líneas nuevas vienen de un modelo.",
