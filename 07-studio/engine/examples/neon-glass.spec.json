      "visual": { "type": "scene3d", "layout": "hero", "camera": "dolly", "objects": [{ "kind": "lightbulb", "label": "Criterio", "highlight": true }, { "kind": "check", "size": 0.9 }, { "kind": "key", "size": 0.9 }] }
