  "scenes": [
    {
      "id": "hook",
      "narration": "SDD y ODD suenan parecido, pero trabajan al revés.",
      "title": {
        "kicker": "Dos formas de",
        "main": "programar con IA"
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "split",
            "divider": "vs",
            "left": [
              {
                "type": "icon",
                "name": "file-text",
                "label": "SDD",
                "size": "l",
                "color": "accent2"
              }
            ],
            "right": [
              {
                "type": "icon",
                "name": "magnifying-glass",
                "label": "ODD",
                "size": "l",
                "color": "accent3"
              }
            ]
          },
          {
            "type": "badge",
            "text": "¿Cuál usar?",
            "icon": "question"
          }
        ]
      }
    },
    {
      "id": "sdd-spec",
      "narration": "SDD es desarrollo guiado por especificación: primero escribes qué debe hacer el sistema.",
      "title": {
        "kicker": "SDD significa",
        "main": "spec primero"
      },
      "hud": {
        "mode": {
          "value": "SDD"
        },
        "spec": {
          "value": 0.45
        }
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "doc",
            "id": "spec",
            "title": "spec.md",
            "lines": [
              "Exportar pedidos a CSV",
              "Máximo 10.000 filas",
              "Error claro si falla"
            ],
            "stamp": "APROBADA"
          },
          {
            "type": "callout",
            "target": "spec",
            "shape": "underline",
            "label": "el qué, no el cómo"
          }
        ]
      }
    },
    {
      "id": "sdd-flow",
      "narration": "La spec se vuelve un plan, el plan en tareas, y cada tarea se implementa siguiendo la spec.",
      "title": {
        "kicker": "El camino SDD",
        "main": "spec → plan → tareas"
      },
      "hud": {
        "spec": {
          "value": 1
        },
        "code": {
          "value": 0.2
        }
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "flow",
            "id": "flow",
            "direction": "vertical",
            "nodes": [
              {
                "label": "Spec",
                "icon": "file-text"
              },
              {
                "label": "Plan",
                "icon": "map-trifold"
              },
              {
                "label": "Tareas",
                "icon": "list-checks"
              },
              {
                "label": "Código",
                "icon": "code"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sdd-code",
      "narration": "La IA escribe el código mirando la spec, sin improvisar.",
      "title": {
        "kicker": "La IA implementa",
        "main": "fiel a la spec"
      },
      "hud": {
        "code": {
          "value": 0.6
        }
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "code",
            "id": "code",
            "title": "export.ts",
            "lines": [
              "// spec: máximo 10.000 filas",
              "const MAX = 10_000;",
              "if (rows > MAX) {",
              "  throw new Error(\"Límite\");",
              "}"
            ]
          },
          {
            "type": "callout",
            "target": "code",
            "shape": "box",
            "label": "sale de la spec"
          }
        ]
      }
    },
    {
      "id": "sdd-when",
      "narration": "Brilla cuando todo está claro y varios equipos deben acordar antes de programar.",
      "title": {
        "kicker": "SDD brilla cuando",
        "main": "todo está claro"
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "checklist",
            "items": [
              "Requisitos claros",
              "Varios equipos",
              "Contratos de API"
            ]
          },
          {
            "type": "counter",
            "value": 1,
            "label": "fuente de verdad",
            "color": "accent2"
          }
        ]
      }
    },
    {
      "id": "sdd-risk",
      "narration": "El riesgo: el código cambia, la spec no, y termina describiendo un sistema que ya no existe.",
      "title": {
        "kicker": "Pero cuidado",
        "main": "la spec envejece"
      },
      "hud": {
        "spec": {
          "value": 0.35
        }
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "bars",
            "id": "drift",
            "title": "Desfase spec vs código",
            "unit": "%",
            "max": 100,
            "items": [
              {
                "label": "Mes 1",
                "value": 10,
                "color": "accent3"
              },
              {
                "label": "Mes 3",
                "value": 45,
                "color": "accent2"
              },
              {
                "label": "Mes 6",
                "value": 80,
                "color": "bad"
              }
            ]
          },
          {
            "type": "stamp",
            "text": "DESACTUALIZADA",
            "target": "drift"
          }
        ]
      }
    },
    {
      "id": "odd-explore",
      "narration": "ODD hace lo contrario: primero explora el código real y entiende cómo funciona.",
      "title": {
        "kicker": "ODD empieza",
        "main": "por el código real"
      },
      "hud": {
        "mode": {
          "value": "ODD",
          "color": "accent3"
        },
        "spec": {
          "value": 0
