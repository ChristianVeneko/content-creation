    {
      "id": "odd-size",
      "narration": "Luego mide la tarea. Pequeña: se hace directo. Grande: abre un archivo de tareas.",
      "title": {
        "kicker": "En ODD",
        "main": "el tamaño decide"
      },
      "hud": {
        "code": {
          "value": 0.5
        }
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "split",
