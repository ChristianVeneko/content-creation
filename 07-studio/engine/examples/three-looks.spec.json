  "scenes": [
    {
      "id": "hook",
      "narration": "Tu computadora se cuelga y no sabes por qué. Abres muchos programas y ventanas a la vez, y la memoria se llena.",
      "visual": {
        "type": "gradient"
      }
    },
    {
      "id": "almacen",
      "narration": "Piensa en un almacen: cuando está lleno de cajas de datos, hay que sacar cosas a un camion para hacer espacio.",
      "visual": {
        "type": "gradient"
      }
    },
    {
      "id": "disco",
      "narration": "Ese viaje al disco es lento, y mientras el disco trabaja el sistema espera. Los datos no paran.",
      "visual": {
        "type": "gradient"
      }
    },
    {
      "id": "calor",
      "narration": "Todo ese trabajo da calor, y cuando se calienta mucho el ventilador no alcanza. Lo mejor es cerrar programas y reiniciar.",
      "visual": {
        "type": "gradient"
      }
    }
