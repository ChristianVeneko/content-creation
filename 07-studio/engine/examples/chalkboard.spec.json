      "id": "hook",
      "narration": "Hoy vamos a ver por qué el dinero que ahorras pronto puede crecer solo.",
      "title": {
        "kicker": "la pregunta",
        "main": "¿El dinero crece solo?"
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "icon",
            "name": "piggy-bank",
            "size": "l",
            "label": "tu hucha"
          }
        ]
      }
    },
    {
      "id": "simple",
      "narration": "Empecemos por el interés simple: cada año ganas lo mismo.",
      "title": {
        "kicker": "primero",
        "main": "Interés simple",
        "number": 1
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "card",
            "title": "100 al 10%",
            "body": [
              "ganas 10 cada año",
              "siempre sobre los 100"
            ]
          }
        ]
      },
      "hud": {
        "paso": {
          "value": "Simple"
        },
        "progreso": {
          "value": 0.2
        }
      }
    },
    {
      "id": "compuesto",
      "narration": "En el interés compuesto, los intereses también ganan intereses.",
      "title": {
        "kicker": "después",
        "main": "Interés compuesto",
        "number": 2
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "flow",
            "direction": "horizontal",
            "nodes": [
              "100",
              "110",
              "121",
              "133"
            ]
          },
          {
            "type": "callout",
            "target": "k",
            "shape": "circle"
          },
          {
            "type": "badge",
            "id": "k",
            "text": "intereses sobre intereses"
          }
        ]
      },
      "hud": {
        "paso": {
          "value": "Compuesto"
        },
        "progreso": {
          "value": 0.4
        }
      }
