      "title": {
        "kicker": "la fórmula",
        "main": "C por (1 + r) a la n",
        "number": 3
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "code",
            "lines": [
              "final = capital * (1 + r) ** n",
              "final = 100 * 1.1 ** 10",
              "final = 259"
            ]
          }
        ]
      }
    },
    {
      "id": "comparar",
      "narration": "Tras treinta años, la diferencia es enorme.",
      "title": {
        "kicker": "a 30 años",
        "main": "Simple contra compuesto",
        "number": 4
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "bars",
            "unit": "",
            "items": [
              {
                "label": "simple",
                "value": 400
              },
              {
                "label": "compuesto",
                "value": 1745
              }
            ]
          }
        ]
      },
      "hud": {
        "paso": {
          "value": "Comparar"
        },
        "progreso": {
          "value": 0.6
        }
      }
    },
    {
      "id": "tiempo",
      "narration": "El ingrediente secreto no es la tasa, es el tiempo.",
