            "right": {
              "title": "Verdad",
              "items": [
                "necesito tiempo"
              ]
            },
            "winner": "right"
          }
        ]
      }
    },
    {
      "id": "repaso",
      "narration": "Repasemos la lección.",
      "title": {
        "kicker": "repaso",
        "main": "Lo que aprendimos"
