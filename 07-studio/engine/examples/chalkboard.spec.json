      "narration": "Un truco: divide 72 entre la tasa y sabrás en cuántos años se duplica.",
      "title": {
        "kicker": "regla del 72",
        "main": "72 entre la tasa",
        "number": 5
      },
      "visual": {
        "type": "illustration",
        "elements": [
          {
            "type": "counter",
            "value": 7.2,
            "decimals": 1,
            "suffix": " años",
            "label": "para duplicar al 10%"
          }
        ]
      },
      "hud": {
        "paso": {
          "value": "Regla 72"
        },
        "progreso": {
          "value": 0.8
        }
      }
    },
    {
      "id": "error",
      "narration": "El error típico es esperar a tener mucho para empezar.",
      "title": {
        "kicker": "error común",
        "main": "Empezar tarde"
